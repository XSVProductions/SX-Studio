<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed, like the old app: it edits the show folder, starts
	     ShowXpress and the DMX helper, and serves phones on the network. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
